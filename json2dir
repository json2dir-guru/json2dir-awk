#!/bin/sh
# GNU awk (json2dir.awk) owns UTF-8 checking, JSON parsing, validation, traversal and
# shell generation; this launcher only moves bytes and runs the generated script.
set -eu

if [ "$#" -ne 0 ]; then
  printf '%s\n' 'Usage: json2dir < file.json' >&2
  exit 2
fi

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

task_tmp=$(umask 077; mktemp -d "${TMPDIR:-/tmp}/json2dir.XXXXXXXXXX")
trap 'rm -rf -- "$task_tmp"' 0
trap 'exit 1' HUP INT TERM

if ! (umask 077; cat > "$task_tmp/input.json"); then
  printf '%s\n' "json2dir: couldn't read stdin" >&2
  exit 1
fi

# Evaluation finishes before anything runs, so an invalid document never executes a
# partial script. gawk runs in byte mode (C locale, -b) so the input is read byte-exact.
if ! (
  umask 077
  LC_ALL=C "${JSON2DIR_GAWK:-gawk}" -b -f "$script_dir/json2dir.awk" "$task_tmp/input.json" \
    > "$task_tmp/tree.sh"
); then
  exit 1
fi

"${JSON2DIR_SHELL:-/bin/sh}" "$task_tmp/tree.sh"
